<?xml version="1.0" encoding="utf-8"?>
<!-- Copied into dist/ at publish time (publish-staging.ps1) — becomes the static site's
     own web.config in IIS. Handles four things a plain static-file site doesn't do on its own:
       1. Routes /api/* through to the API — which IIS hosts as a nested Application aliased
          "backend", NOT "api". If it were aliased "api", IIS would strip that segment as the
          app's own PathBase before handing the request to it — but every route in Akrho.Api is
          registered WITH a literal "/api/" prefix already (CLAUDE.md's own endpoint convention),
          so the app would then be looking for "/api/regions" inside a request it only sees as
          "/regions", and 404. Rewriting to /backend/api/... first means IIS strips "/backend"
          instead, leaving the app the exact "/api/..." path its routes expect. This rule must
          stay ahead of "SPA fallback" below.
       2. Routes /hubs/* (the ChatHub SignalR endpoint, Program.cs's own
          app.MapHub<ChatHub>("/hubs/chat")) through to the same "backend" Application, for the
          identical reason as /api/* above — Akrho.Api's own route is "/hubs/chat", so IIS must
          strip "/backend" and nothing else. Without this rule, every negotiate/WebSocket
          request for chat falls through to "SPA fallback" below (a GET quietly returns
          index.html; a POST hits IIS's own static-file handler and 405s) — found live: public
          chat showing "offline" forever on staging, with the API itself never even seeing the
          connection attempt.
       3. React Router routes (e.g. /register-chapter, /portal/chapter-registrations) are not
          real files on disk — without this rewrite, a hard refresh or a direct link to one
          404s. Anything that isn't an existing file falls back to index.html and the
          client-side router takes it from there.
       4. Correct MIME type for the service worker (src/sw.ts, built to sw.js) — IIS serves
          unknown extensions as application/octet-stream by default, which some browsers refuse
          to register as a service worker. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".js" />
      <mimeMap fileExtension=".js" mimeType="text/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="API passthrough" stopProcessing="true">
          <match url="^api/(.*)$" />
          <action type="Rewrite" url="backend/api/{R:1}" />
        </rule>
        <rule name="Hubs passthrough" stopProcessing="true">
          <match url="^hubs/(.*)$" />
          <action type="Rewrite" url="backend/hubs/{R:1}" />
        </rule>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_URI}" pattern="^/api/" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/hubs/" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>

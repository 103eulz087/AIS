<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom template — dotnet publish transforms this (injecting/updating the <aspNetCore>
  element per the publish profile) rather than generating one from scratch, so this
  survives every future build-for-staging run automatically.

  WHY THE <modules>/<handlers> REMOVE BLOCKS EXIST: IIS's WebDAV Publishing module, if
  enabled on the server, intercepts PUT/DELETE (and other WebDAV verbs) ahead of the
  aspNetCore handler below and returns IIS's own bare 405 page before the request ever
  reaches Kestrel. Confirmed live on staging 2026-09-22: every PUT/DELETE endpoint in
  this API 405'd identically — including a route that does not exist at all, proving it
  was verb-level, not route-level. GET/POST were unaffected, which is exactly why this
  went undiscovered until the first PUT/DELETE feature (chapter officer seat/unseat,
  member identity edit) was actually exercised against staging. This removal is scoped
  to just this Application (the nested "backend" alias, CLAUDE.md §8.10) — no
  server-wide WebDAV uninstall, nothing else on the shared box is touched.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Akrho.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
